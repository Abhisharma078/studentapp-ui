pipeline {
    agent {
        label "worker"
    }

    tools {
        maven 'maven'
    }

    environment{
        MY_AWS_CRED = credentials('aws-cred')
    }

    stages {
        stage("checkout"){
            steps{
                git 'https://github.com/mayurpandit25/studentapp-ui.git'
                echo "Clonning is successful"
            }
        }

        stage("Build"){
            steps{
                sh 'mvn clean package'
            }
            post{
                success{
                    archiveArtifacts artifacts: '**/target/*.war', fingerprint: true
                }
            }
        }

        stage('Artifacts to s3'){
            steps{
                sh '''
                  aws s3 cp target/*.war s3://mayurcbz.spacee/Arfifacts/student.war
                '''
            }
        }
    }
}