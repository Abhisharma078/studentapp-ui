pipeline{
    agent{
        label 'worker'
    }
    
    tools{
        maven 'mvn'
    }

    environment{
        my_aws = credentials('aws-cred')
    }

    stages{
        stage('checkout'){
            steps{
            git 'https://github.com/Abhisharma078/studentapp-ui.git'
            echo "checkout is succefull"
        }
    }

        stage('build'){
            steps {
               sh '''
                  mvn clean package 
                '''
            } 
            post{
                success{
                    archiveArtifacts artifacts: '**/target/*.war', fingerprint: true 
                }
            }  
        }

        stage('artifacts to s3'){
            steps{
                sh '''
                 aws cp s3 target/*.war  s3://abhicloud.online/Artifacts/student.war
                 '''
            }
        }

        stage('SonarQube Analysis'){
            steps{
                withSonarQubeEnv('sonar'){
                sh 'mvn sonar:sonar'
              }
           }
        }

        stage('Quality gates'){
            steps {
                timeout(time: 5 , unit: 'MINUTES'){
                    waitForQualityGates  abortpipeline: true
                }
            }
        }

        stage('docker build'){
            steps{
                sh '''
                  docker build -t student .
                  docker images
                  '''
            }
        }

        stage('push to ECR'){
            steps{
                sh '''
                aws ecr get-login-password --region us-east-1 | docker login --username AWS --password-stdin 822920903800.dkr.ecr.us-east-1.amazonaws.com
                docker tag student:latest 822920903800.dkr.ecr.us-east-1.amazonaws.com/student:latest
                docker push 822920903800.dkr.ecr.us-east-1.amazonaws.com/student:latest
                '''
            }
        }
        
        stage('Deployment on k8s'){
            steps{
                sh '''
                  aws eks update-kubeconfig --name mycluster --region ap-south-1
                  kubectl apply -f k8s/
                  kubectl get pods
                  sleep 20
                  kubectl get pods
                  kubectl get svc
                  '''
            }
        }
    }
}