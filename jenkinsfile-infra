pipeline{
    agent{
        label 'worker'
    }

    tools{
        terraform 'tf'
    }

    environment{
        my-aws = credentials('aws-cred')
    }

    stages{
        stage('checkout'){
            steps{
              git 'https://github.com/Abhisharma078/studentapp-ui.git'
             echo "checkout is succefull"
            }
        }

        stage('terraform init'){
            steps{
                sh 'terraform init'
            }
        }

        stage('terraform validate'){
            steps{
                sh 'terraform validate'
            }
        }
        
        stage('terraform apply'){
            steps{
                sh '''
                terraform apply --auto-approve
                '''
            }
        }
    }
}